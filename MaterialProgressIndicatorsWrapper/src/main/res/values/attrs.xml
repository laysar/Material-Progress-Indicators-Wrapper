<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="MaterialProgressIndicators">
        <attr name="IndicatorType" format="enum">
            <enum name="Loading" value="0" />
            <enum name="Circular" value="1" />
            <enum name="Linear" value="2" />
        </attr>
        <attr name="Variant" format="enum">
            <enum name="Default" value="0" />
            <enum name="Contained" value="1" />
            <enum name="Legacy" value="2" />
            <enum name="Wavy" value="3" />
            <enum name="Medium" value="4" />
            <enum name="Small" value="5" />
            <enum name="ExtraSmall" value="6" />
        </attr>
        <attr name="Color" format="color|reference" />
        <attr name="Size" format="dimension|string|reference" />
        <attr name="ContainerColor" format="color|reference" />
        <attr name="ContainerSize" format="dimension|string|reference" />
        <attr name="ContainerHeight" format="dimension|string|reference" />
        <attr name="ContainerWidth" format="dimension|string|reference" />
        <attr name="ShowDelay" format="integer|reference" />
        <attr name="MinHideDelay" format="integer|reference" />
        <attr name="Indeterminate" format="boolean" />
        <attr name="Progress" format="integer" />
        <attr name="Max" format="integer" />
        <attr name="TrackColor" format="color|reference" />
        <attr name="TrackThickness" format="dimension|string|reference" />
        <attr name="TrackCorners" format="dimension|fraction|string|reference" />
        <attr name="TrackGap" format="dimension|string|reference" />
        <attr name="Speed" format="float|reference" />
        <attr name="ShowAnimation" format="enum">
            <enum name="None" value="0" />
            <enum name="Outward" value="1" />
            <enum name="Inward" value="2" />
        </attr>
        <attr name="HideAnimation" format="enum">
            <enum name="None" value="0" />
            <enum name="Outward" value="1" />
            <enum name="Inward" value="2" />
            <enum name="Escape" value="3" />
        </attr>
        <attr name="HideVisibility" format="enum">
            <enum name="Visible" value="0" />
            <enum name="Invisible" value="4" />
            <enum name="Gone" value="8" />
        </attr>
        <attr name="WaveLength" format="dimension|string|reference" />
        <attr name="WaveLengthDeterminate" format="dimension|string|reference" />
        <attr name="WaveLengthIndeterminate" format="dimension|string|reference" />
        <attr name="WaveAmplitude" format="dimension|string|reference" />
        <attr name="WaveSpeed" format="dimension|string|reference" />
        <attr name="WaveRangeMin" format="float|reference" />
        <attr name="WaveRangeMax" format="float|reference" />
        <attr name="AutoHide" format="boolean" />
        <attr name="Inset" format="dimension|string|reference" />
        <attr name="Direction" format="enum">
            <enum name="Auto" value="0" />
            <enum name="Natural" value="1" />
            <enum name="StartToEnd" value="2" />
            <enum name="EndToStart" value="3" />
            <enum name="LeftToRight" value="4" />
            <enum name="RightToLeft" value="5" />
        </attr>
        <attr name="Animation" format="enum">
            <enum name="Smooth" value="0" />
            <enum name="Trash" value="1" />
            <enum name="Disjoint" value="2" />
            <enum name="Contiguous" value="3" />
        </attr>
        <attr name="StopSize" format="dimension|string|reference" />
        <attr name="StopPadding" format="dimension|string|reference" />
        <attr name="InnerCorners" format="dimension|fraction|string|reference" />
        <attr name="SpringStiffness" format="float|reference" />
        <attr name="SpringDamping" format="float|reference" />
    </declare-styleable>
</resources>
